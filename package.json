{
  "name": "kap",
  "version": "5.1.0",
  "private": true,
  "description": "Community-driven Kap fork focused on reliability and community maintenance",
  "license": "MIT",
  "repository": "jacobpowaza/NewKap",
  "homepage": "https://github.com/jacobpowaza/NewKap",
  "author": "Kap Contributors (https://github.com/jacobpowaza/NewKap)",
  "main": "./dist-js/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "lint": "xo",
    "lint:fix": "xo --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test:main": "ava",
    "test": "pnpm lint && pnpm test:main",
    "start": "tsc && node scripts/run-electron.js .",
    "build-main": "tsc",
    "build-native": "mkdir -p native/build && swiftc -O -target arm64-apple-macos13.0 native/kap-helper.swift -o native/build/kap-helper",
    "build-renderer": "node --openssl-legacy-provider node_modules/next/dist/bin/next build renderer && node --openssl-legacy-provider node_modules/next/dist/bin/next export renderer",
    "build": "pnpm build-native && pnpm build-main && pnpm build-renderer",
    "dist": "pnpm build && electron-builder",
    "pack": "pnpm build && electron-builder --dir",
    "pack:local": "pnpm build && electron-builder --dir -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "postinstall": "electron-builder install-app-deps && pnpm build-native",
    "dev": "next dev renderer"
  },
  "dependencies": {
    "ajv": "^6.12.2",
    "aperture": "6.1.2",
    "baseline-browser-mapping": "^2.10.43",
    "caniuse-lite": "^1.0.30001806",
    "classnames": "^2.2.6",
    "clean-stack": "^3.0.1",
    "electron-better-ipc": "^1.1.1",
    "electron-next": "^3.1.5",
    "electron-store": "^7.0.2",
    "electron-util": "^0.14.2",
    "ensure-error": "^3.0.1",
    "execa": "5.0.0",
    "ffmpeg-static": "^5.3.0",
    "gifsicle": "^7.0.1",
    "got": "^9.6.0",
    "linkify-react": "^4.4.0",
    "linkifyjs": "^4.4.0",
    "lodash": "^4.18.1",
    "nearest-normal-aspect-ratio": "^1.2.1",
    "object-hash": "^2.1.1",
    "p-cancelable": "^2.1.0",
    "package-json": "^6.5.0",
    "pretty-bytes": "^5.6.0",
    "pretty-ms": "^7.0.1",
    "prop-types": "^15.7.2",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-tooltip": "^4.2.19",
    "read-pkg": "^5.2.0",
    "semver": "^7.8.6",
    "string-math": "^1.2.2",
    "tempy": "^1.0.0",
    "tildify": "^2.0.0",
    "unstated-next": "^1.1.0",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "^0.7.0",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/got": "9.6.12",
    "@types/lodash": "^4.14.168",
    "@types/node": "^24.19.2",
    "@types/object-hash": "^1.3.4",
    "@types/react": "^17.0.3",
    "@types/semver": "^7.8.0",
    "@types/sinon": "^22.0.2",
    "ava": "^7.0.0",
    "electron": "45.3.1",
    "electron-builder": "^26.18.0",
    "eslint-config-xo-react": "^0.32.0",
    "globals": "17.14.0",
    "module-alias": "^2.3.5",
    "next": "^10.0.8",
    "sinon": "^22.1.0",
    "tsx": "^4.23.15",
    "type-fest": "^2.11.1",
    "typed-emitter": "^1.3.1",
    "typescript": "^5.9.3",
    "unique-string": "^2.0.0",
    "xo": "^5.0.1"
  },
  "productName": "Kap",
  "bundle": {
    "name": "Kap"
  },
  "_moduleAliases": {
    "electron": "test/mocks/electron.ts"
  },
  "ava": {
    "files": [
      "test/**/*.ts",
      "test/**/*.js",
      "!test/helpers",
      "!test/mocks"
    ],
    "extensions": [
      "ts"
    ],
    "verbose": true,
    "timeout": "5m",
    "failFast": true,
    "workerThreads": false,
    "require": [
      "tsx/cjs",
      "module-alias/register"
    ]
  },
  "build": {
    "appId": "com.wulkano.kap",
    "afterPack": "./scripts/after-pack.js",
    "protocols": {
      "name": "kap",
      "schemes": [
        "kap"
      ]
    },
    "files": [
      "static",
      "dist-js/**/*",
      "!dist-js/**/*.map",
      "!dist-js/.tsbuildinfo",
      "!renderer",
      "renderer/out",
      "!renderer/out/**/*.map",
      "!**/*.map",
      "!**/.DS_Store",
      "!**/test/**",
      "!**/tests/**"
    ],
    "extraResources": [
      {
        "from": "native/build/kap-helper",
        "to": "kap-helper"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0.0",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "./build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "LSUIElement": true,
        "CFBundleDisplayName": "Kap",
        "CFBundleName": "Kap",
        "NSMicrophoneUsageDescription": "Kap needs access to the microphone to record audio with screen recordings.",
        "NSCameraUsageDescription": "A Kap plugin wants to use the camera.",
        "NSUserNotificationAlertStyle": "alert",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Video",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.mpeg-4",
              "com.apple.quicktime-movie"
            ]
          }
        ]
      },
      "target": {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "iconSize": 160,
      "contents": [
        {
          "x": 180,
          "y": 170
        },
        {
          "x": 480,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
