{
  "name": "kap",
  "productName": "Kap",
  "version": "5.1.0",
  "description": "Community-driven Kap fork focused on reliability and community maintenance",
  "license": "MIT",
  "repository": "jacobpowaza/NewKap",
  "homepage": "https://github.com/jacobpowaza/NewKap",
  "author": {
    "name": "Kap Contributors",
    "url": "https://github.com/jacobpowaza/NewKap"
  },
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "packageManager": "pnpm@12.18.0",
  "main": "dist-js/index.js",
  "scripts": {
    "lint": "xo",
    "lint:fix": "xo --fix",
    "typecheck": "tsc --noEmit",
    "test:main": "TS_NODE_PROJECT=test/tsconfig.json ava",
    "test:ci": "pnpm test:main --tap | tap-xunit > ~/reports/ava.xml",
    "test": "pnpm lint && pnpm test:main",
    "start": "tsc && node scripts/run-electron.js .",
    "build-main": "tsc",
    "build-native": "mkdir -p native/build && swiftc -O -target arm64-apple-macos12.0 native/kap-helper.swift -o native/build/kap-helper",
    "build-renderer": "node --openssl-legacy-provider node_modules/next/dist/bin/next build renderer && node --openssl-legacy-provider node_modules/next/dist/bin/next export renderer",
    "build": "pnpm build-native && pnpm build-main && pnpm build-renderer",
    "dist": "pnpm build && electron-builder",
    "pack": "pnpm build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps && pnpm build-native",
    "sentry-version": "echo \"$npm_package_name@$npm_package_version\"",
    "dev": "next dev renderer"
  },
  "bundle": {
    "name": "Kap"
  },
  "dependencies": {
    "@sindresorhus/to-milliseconds": "^1.2.0",
    "ajv": "^6.12.2",
    "aperture": "^6.1.2",
    "base64-img": "^1.0.4",
    "baseline-browser-mapping": "^2.10.43",
    "caniuse-lite": "^1.0.30001806",
    "classnames": "^2.2.6",
    "clean-stack": "^3.0.1",
    "cp-file": "^9.0.0",
    "delay": "^5.0.0",
    "electron-better-ipc": "^1.1.1",
    "electron-next": "^3.1.5",
    "electron-store": "^7.0.2",
    "electron-util": "^0.14.2",
    "ensure-error": "^3.0.1",
    "execa": "5.0.0",
    "ffmpeg-static": "^4.4.1",
    "gifsicle": "^7.0.1",
    "got": "^9.6.0",
    "lodash": "^4.17.21",
    "macos-version": "^5.2.1",
    "make-dir": "^3.1.0",
    "moment": "^2.29.1",
    "nearest-normal-aspect-ratio": "^1.2.1",
    "object-hash": "^2.1.1",
    "p-cancelable": "^2.1.0",
    "p-event": "^4.2.0",
    "package-json": "^6.5.0",
    "pify": "^5.0.0",
    "plist": "^3.0.4",
    "pretty-bytes": "^5.6.0",
    "pretty-ms": "^7.0.1",
    "prop-types": "^15.7.2",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-linkify": "^0.2.2",
    "react-tooltip": "^4.2.19",
    "read-pkg": "^5.2.0",
    "semver": "^7.3.4",
    "string-math": "^1.2.2",
    "tempy": "^1.0.0",
    "tildify": "^2.0.0",
    "unstated": "^1.2.0",
    "unstated-next": "^1.1.0",
    "yarn": "^1.22.10"
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "^0.7.0",
    "@types/ffmpeg-static": "^3.0.0",
    "@types/got": "9.6.12",
    "@types/lodash": "^4.14.168",
    "@types/module-alias": "^2.0.0",
    "@types/node": "^14.11.10",
    "@types/object-hash": "^1.3.4",
    "@types/react": "^17.0.3",
    "@types/semver": "^7.8.0",
    "@types/sinon": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^4.15.0",
    "@typescript-eslint/parser": "^4.15.0",
    "ava": "^3.15.0",
    "babel-eslint": "^10.1.0",
    "electron": "43.1.1",
    "electron-builder": "^23.3.3",
    "electron-builder-notarize": "^1.4.0",
    "eslint-config-xo": "^0.35.0",
    "eslint-config-xo-react": "^0.24.0",
    "eslint-config-xo-typescript": "^0.38.0",
    "eslint-plugin-import": "2.24.0",
    "eslint-plugin-react": "^7.22.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "module-alias": "^2.2.2",
    "next": "^10.0.8",
    "sinon": "^9.2.4",
    "tap-xunit": "^2.4.1",
    "ts-node": "^10.4.0",
    "type-fest": "^2.11.1",
    "typed-emitter": "^1.3.1",
    "typescript": "^4.0.3",
    "unique-string": "^2.0.0",
    "xo": "^0.38.2"
  },
  "_moduleAliases": {
    "electron": "test/mocks/electron.ts"
  },
  "ava": {
    "files": [
      "test/**/*.ts",
      "test/**/*.js",
      "!test/helpers",
      "!test/mocks"
    ],
    "extensions": [
      "ts"
    ],
    "verbose": true,
    "timeout": "5m",
    "failFast": true,
    "require": [
      "ts-node/register",
      "module-alias/register"
    ]
  },
  "xo": {
    "extends": "xo-react",
    "space": 2,
    "envs": [
      "node",
      "browser"
    ],
    "rules": {
      "template-curly-spacing": "off",
      "import/no-extraneous-dependencies": "off",
      "import/no-unassigned-import": "off",
      "import/no-named-as-default-member": "off",
      "react/jsx-closing-tag-location": "off",
      "react/require-default-props": "off",
      "react/jsx-curly-brace-presence": "off",
      "react/static-property-placement": "off",
      "react/react-in-jsx-scope": "off",
      "react/boolean-prop-naming": "off",
      "unicorn/prefer-set-has": "off",
      "ava/use-test": "off",
      "import/extensions": "off",
      "node/file-extension-in-import": "off"
    },
    "ignores": [
      "dist-js",
      "dist",
      "renderer/.next",
      "renderer/out",
      "renderer/next.config.js"
    ],
    "overrides": [
      {
        "files": [
          "**/*.js",
          "**/*.jsx"
        ],
        "parser": "babel-eslint"
      },
      {
        "files": [
          "**/*.ts",
          "**/*.tsx"
        ],
        "extends": [
          "xo-react",
          "xo-typescript"
        ],
        "parserOptions": {
          "project": [
            "tsconfig.json",
            "renderer/tsconfig.json",
            "test/tsconfig.json"
          ]
        },
        "rules": {
          "react-hooks/exhaustive-deps": "off",
          "@typescript-eslint/no-dynamic-delete": "off",
          "@typescript-eslint/no-var-requires": "off",
          "@typescript-eslint/no-floating-promises": "off",
          "@typescript-eslint/no-implicit-any-catch": "off",
          "@typescript-eslint/restrict-template-expressions": "off",
          "no-await-in-loop": "off",
          "react/prop-types": "off",
          "@typescript-eslint/no-confusing-void-expression": "off",
          "@typescript-eslint/indent": [
            "error",
            2
          ]
        }
      },
      {
        "files": [
          "test/**/*.ts"
        ],
        "rules": {
          "@typescript-eslint/consistent-type-assertions": "off",
          "@typescript-eslint/member-ordering": "off",
          "import/no-anonymous-default-export": "off",
          "@typescript-eslint/no-extraneous-class": "off",
          "@typescript-eslint/no-empty-function": "off"
        }
      }
    ]
  },
  "build": {
    "appId": "com.wulkano.kap",
    "afterPack": "./scripts/after-pack.js",
    "afterSign": "electron-builder-notarize",
    "protocols": {
      "name": "kap",
      "schemes": [
        "kap"
      ]
    },
    "files": [
      "static",
      "dist-js/**/*",
      "!dist-js/**/*.map",
      "!dist-js/.tsbuildinfo",
      "!renderer",
      "renderer/out",
      "!renderer/out/**/*.map",
      "!**/*.map",
      "!**/.DS_Store",
      "!**/test/**",
      "!**/tests/**"
    ],
    "extraResources": [
      {
        "from": "native/build/kap-helper",
        "to": "kap-helper"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "electronUpdaterCompatibility": ">=2.16",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0.0",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "./build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "LSUIElement": true,
        "CFBundleDisplayName": "Kap",
        "CFBundleName": "Kap",
        "NSMicrophoneUsageDescription": "Kap needs access to the microphone to record audio with screen recordings.",
        "NSCameraUsageDescription": "A Kap plugin wants to use the camera.",
        "NSUserNotificationAlertStyle": "alert",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Video",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.mpeg-4",
              "com.apple.quicktime-movie"
            ]
          }
        ]
      },
      "target": {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "iconSize": 160,
      "contents": [
        {
          "x": 180,
          "y": 170
        },
        {
          "x": 480,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
